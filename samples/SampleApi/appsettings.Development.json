{
  "CoreSetup": {
    "Jwt": {
      "Authority": "https://auth.boricuacoder.dev/realms/dev-realm",
      "Audience": "account",
      "RequireHttpsMetadata": true,
      "TokenValidation": {
        "ValidateIssuer": true,
        "ValidateAudience": true,
        "ValidateLifetime": true,
        "ClockSkewSeconds": 300
      }
    },
    "Swagger": {
      "Enabled": true,
      "Title": "Sample API (Dev)",
      "Version": "v1",
      "OAuth": {
        "AuthorizationUrl": "https://auth.boricuacoder.dev/realms/dev-realm/protocol/openid-connect/auth",
        "TokenUrl": "https://auth.boricuacoder.dev/realms/dev-realm/protocol/openid-connect/token",
        "ClientId": "swagger-ui-dev",
        "Scopes": {
          "openid": "OpenID Connect",
          "profile": "User profile",
          "email": "Email address"
        }
      }
    },
    "Redis": {
      "Enabled": true,
      "PrefixKey": "sample:api::",
      "ConnectionString": "localhost:6379",
      "DefaultTTL": 60,
      "ShortCircuit": 2
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information"
    }
  }
}
